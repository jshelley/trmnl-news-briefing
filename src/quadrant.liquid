{%- assign ranked_s = ranked_at | date: "%s" | plus: 0 -%}
{%- assign off = trmnl.user.utc_offset | default: 0 | plus: 0 -%}
{%- if off != 0 -%}{%- assign ranked_local = ranked_s | plus: off -%}{%- assign ranked = ranked_local | date: "%-I:%M %p" -%}{%- else -%}{%- assign ranked = ranked_at | date: "%H:%M" | append: " UTC" -%}{%- endif -%}
{% if lead %}
<style>
  .bs-clamp { display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }
  .bs-2 { -webkit-line-clamp: 2; }
  .bs-3 { -webkit-line-clamp: 3; }
</style>
<div class="layout layout--col layout--top gap--small">
  <div class="flex flex--col flex--left gap--small">
    <span class="title title--small lg:title--large bs-clamp bs-2">{{ lead.headline }}</span>
    <span class="description lg:description--large bs-clamp bs-2">{{ lead.summary }}</span>
  </div>
  <div class="divider"></div>
  <div class="columns" data-overflow-max-cols="1" data-overflow-max-cols-lg="1" data-overflow-max-cols-portrait="1" data-overflow-max-cols-lg-portrait="1">
    <div class="column" data-list-limit="true" data-list-max-height="auto">
      {% for s in stories %}
      <div class="item">
        <div class="meta"><span class="index">{{ forloop.index | plus: 1 }}</span></div>
        <div class="content">
          <span class="title title--small lg:title--base" data-clamp="1" data-clamp-lg="2">{{ s.headline }}</span>
        </div>
      </div>
      {% endfor %}
      {% for r in research %}
      <div class="item">
        <div class="meta"><span class="index">R{{ forloop.index }}</span></div>
        <div class="content"><span class="title title--small lg:title--base" data-clamp="1" data-clamp-lg="2">{{ r.headline }}</span></div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--top"><span class="label">No stories available yet</span></div>
{% endif %}
<div class="title_bar"><span class="title">{{ name }}</span><span class="instance">{{ ranked }}</span></div>
