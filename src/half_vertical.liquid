{%- assign ranked_s = ranked_at | date: "%s" | plus: 0 -%}
{%- assign off = trmnl.user.utc_offset | default: 0 | plus: 0 -%}
{%- if off != 0 -%}{%- assign ranked_local = ranked_s | plus: off -%}{%- assign ranked = ranked_local | date: "%-I:%M %p" -%}{%- else -%}{%- assign ranked = ranked_at | date: "%H:%M" | append: " UTC" -%}{%- endif -%}
{% if lead %}
<style>
  .bs-clamp { display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }
  .bs-2 { -webkit-line-clamp: 2; }
  .bs-3 { -webkit-line-clamp: 3; }
</style>
<div class="layout layout--col layout--top gap--small lg:gap--medium">
  <div class="flex flex--left gap--small" style="align-items:flex-start;width:100%">
    <div class="flex flex--col flex--left gap--small" style="flex:1 1 auto;min-width:0">
      <span class="label label--small label--underline text--left">Top story</span>
      <span class="title title--base lg:title--large bs-clamp bs-2">{{ lead.headline }}</span>
      <span class="description lg:description--large bs-clamp bs-3">{{ lead.summary }}</span>
      <span class="label label--small">{{ lead.source }}{% if lead.qr %} · scan to read{% endif %}</span>
    </div>
    {% if lead.qr %}<img src="{{ lead.qr }}" width="93" height="93" alt="" style="flex:0 0 auto;width:93px;height:93px;image-rendering:pixelated">{% endif %}
  </div>
  <div class="divider"></div>
  <div class="columns" data-overflow-max-cols="1" data-overflow-max-cols-lg="1" data-overflow-max-cols-portrait="1" data-overflow-max-cols-lg-portrait="1">
    <div class="column" data-list-limit="true" data-list-max-height="auto">
      {% for s in stories %}
      <div class="item">
        <div class="meta"><span class="index">{{ forloop.index | plus: 1 }}</span></div>
        <div class="content">
          <span class="title title--small lg:title--large" data-clamp="2" data-clamp-lg="3">{{ s.headline }}</span>
          <span class="label label--small">{{ s.source }}</span>
        </div>
      </div>
      {% endfor %}
      {% for r in research %}
      <div class="item">
        <div class="meta"><span class="index">R{{ forloop.index }}</span></div>
        <div class="content">
          <span class="title title--small lg:title--base" data-clamp="2" data-clamp-lg="3">{{ r.headline }}</span>
          <span class="label label--small">Research · {{ r.source }}</span>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--top"><span class="label">No stories available yet</span></div>
{% endif %}
<div class="title_bar"><span class="title">{{ name }}</span><span class="instance">{{ ranked }}</span></div>
